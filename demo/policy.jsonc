// The demo policy. This file is the trusted part of cleanroom's
// configuration: it names the upstream MCP servers, says what their content
// carries, and says what each tool can do. No model can change it.
//
// Commands run with this file's directory as their working directory.
{
	// The agent this policy is for holds its user's notes, which cleanroom
	// cannot see. So every session counts as private from the start, and a
	// session that becomes contaminated cannot send data out unapproved.
	"sessions_start_private": true,

	"upstreams": {
		// The inbox is the hard case: private, and anyone can put text in it.
		"mail": {
			"command": ["../bin/mail-source", "--mailpit-url", "http://127.0.0.1:18025"],
			"labels": ["contaminated", "private"],

			// Agents cannot read mail directly. They ask, and a reader reads.
			"ask_only": true,
			"reader": ["../bin/demo-reader",
				"--mcp-config", "{mcp_config}",
				"--question", "{question}",
				"--returns", "{returns}"],

			// These are all the tools the mail server has. It cannot send,
			// so there is no send tool here to allow or to hold.
			"tools": {
				"search": {"class": "read"},
				"read": {"class": "read"},
			},
		},

		// A calendar and reminders, written to local files. The server
		// describes its create tools as non-destructive writes. The policy
		// overrides that: creating an event is acting for the user.
		// Cleanroom discards what these tools return and tells the caller
		// only whether they ran.
		"calendar": {
			"command": ["../bin/calendar-source", "--dir", ".cleanroom/calendar"],
			"labels": [],
			"tools": {
				"create_event": {"class": "act", "discard_result": true},
				"create_reminder": {"class": "act", "discard_result": true},
			},
		},
	},
}
