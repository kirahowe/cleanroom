# Built binaries and downloaded tools.
/bin/
/.tools/

# Runtime state. The event log holds the text of answers and held calls,
# which for a mail source means email text.
.cleanroom/

# Credentials for real mailboxes never belong in the repository.
*.env

# What `go build` leaves behind when run inside a source's directory.
/sources/mail/mailsource
/sources/calendar/calendarsource

# Worktrees made by coding agents.
/.claude/
